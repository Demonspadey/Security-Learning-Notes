    recover_h, recover_m = parts[3].split(":")
    # 字符串强制转为int数字，换算分钟并入列表
    events.append((
        name,
        int(attack_h)*60 + int(attack_m),
        int(detect_h)*60 + int(detect_m),
        int(recover_h)*60 + int(recover_m),
    ))

total_mttd = 0
total_mttr = 0
