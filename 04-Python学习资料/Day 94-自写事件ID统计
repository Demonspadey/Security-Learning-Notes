events = ["4624", "4625", "4625", "4624", "4720", "4625", "4634", "4624", "4625", "4624"]
count = {}                     # 1.创建空字典，用来存{事件ID:次数}
for event in events:           # 2.循环取出每一个事件id
    count[event] = count.get(event, 0) +1  #3.字典累加；没有这个key就取0，再+1
for id, num in count.items():  # 遍历字典，id是key(事件号)，num是value(次数)
    print(f"{id} → {num}次")
