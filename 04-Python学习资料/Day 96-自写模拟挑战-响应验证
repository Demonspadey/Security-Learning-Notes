import hashlib                          # 导入哈希模块
def verify(challenge, response, secret):
    # 服务器计算预期哈希
    expected = hashlib.sha256((challenge + secret).encode()).hexdigest()
    return expected == response         # 比对返回True/False

challenge = "123456"
secret = "s3cr3t"
# 客户端计算响应哈希
response = hashlib.sha256((challenge + secret).encode()).hexdigest()
print(f"验证结果, {verify(challenge, response, secret)}")
