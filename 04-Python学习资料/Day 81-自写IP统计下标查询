ip_count={}                                     # 创建空字典，key存IP，value存失败次数
log=r"d:\_agent_tmp\sample.txt"                 # Windows原始字符串，指定日志文件路径
with open(log, "r", encoding="utf-8") as f:     # 以只读模式打开文件，with结束自动关闭文件
    for line in f:                              # 逐行迭代读取文件每一行
        if "Failed password" in line:           # 判断该行是否为SSH登录失败日志
            parts = line.split()                # 按空格切割一行日志，得到字符串列表
            idx = parts.index("from")           # 在列表找到单词from，返回它的下标数字
            ip = parts[idx+1]                   # from下标+1，对应位置就是源IP地址
            ip_count[ip] = ip_count.get(ip, 0) + 1 # IP失败次数累加，没有该IP默认0

print("\n==== SSH失败IP Top5 ====")                         # 打印标题换行
top5 = sorted(ip_count.items(), key=lambda x:x[1], reverse=True)[:5] # 按次数降序，取前5
for ip, cnt in top5:                                        # 循环遍历排序后的(IP,次数)元组
    print(f"{ip} → {cnt}次")                                # f-string格式化输出结果

| 零件 | 作用 | 三句话 |
|------|------|--------|
| `ip_count.items()` | 把字典变成 **键值对列表**：`[("192.168.1.100",5),("10.0.0.5",3)]` | 
   ①字典本身没法直接排，转成列表 ②不加就只有一个裸字典 ③想"同时拿到键和值"时用 |
| `key=lambda x: x[1]` | **告诉 sorted 按什么排**：每个 `x` 是 `("IP",次数)`，`x[1]`=次数 | 
   ①指定排序依据 ②不加就按默认(键/IP字母序)排 ③想按第二列排时 |
| `reverse=True` | **倒序**（从大到小）| ①要"最多的在前" ②不加就是从小到大 ③要取 Top N 时 |
| `[:5]` | **切片取前5个** | ①只要前5名 ②不加就全返回 ③只要 Top N 时 |
