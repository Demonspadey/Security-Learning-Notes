log_lines = [
    "Mar 1 02:12:31 server sshd[1234]: Failed password for root from 192.168.1.10 port 22",
    "Mar 1 02:13:05 server sshd[1235]: Failed password for root from 10.0.0.5 port 22",
    "Mar 1 02:15:44 server sshd[1236]: Failed password for admin from 192.168.1.10 port 22",
    "Mar 1 02:20:11 server sshd[1237]: Failed password for root from 192.168.1.10 port 22",
    "Mar 1 02:21:33 server sshd[1238]: Failed password for root from 172.16.0.8 port 22",
]
def count_failed_ip(lines):
    ip_count = {}
    for line in lines:
        if "Failed password" not in line:
            continue
        parts = line.split()
        idx = parts.index("from")
        ip = parts[idx+1]
        ip_count[ip] = ip_count.get(ip, 0) +1
    sorted_list = sorted(ip_count.items(), key=lambda x: x[1], reverse=True)
    for ip, cnt in sorted_list:
        print(f"{ip}: {cnt}次")
count_failed_ip(log_lines)
