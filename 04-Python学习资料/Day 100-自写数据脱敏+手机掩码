# 需求：手机号脱敏（数据安全项目/交付报告里打码，安服常用）
phones = ["13912345678", "15898765432", "13655556666"]

def mask_phone(p):
    # 🔴 第一步：写步骤（中文，不写代码）
    #   1. 保留前3位 p[:3]
    #   2. 保留后4位 p[-4:]
    #   3. 中间用 **** 连接：p[:3] + "****" + p[-4:]
    #   4. 返回打码结果
    #   写完步骤 → 对照模式卡"模式3 字符串切片" 翻译


phones =["13912345678", "15898765432", "13655556666"]   # 原始手机号列表
def mask_phone(p):                                      # 定义手机号脱敏函数，p传入手机号字符串
    if len(p) == 11 and p.isdigit():                    # 判断：字符串长度等于11 并且 全部字符都是数字
        return p[:3] + "****" + p[-4:]                  # 切片取前3位 + 4个星号 + 末尾4位，返回脱敏结果
    else:
        return p                                         # 格式不合法，原样返回原始内容

for ph in phones:                                       # 循环遍历每一个手机号
    print(f"脱敏后：{mask_phone(ph)}")                   # 调用脱敏函数，格式化打印输出
