import os
with open(r"D:\_agent_tmp\security.log", "r", encoding="utf-8") as f:
    log_text = f.read()

lines = log_text.strip().split("\n")
print(f"共读取 {len(lines)} 条日志记录")

alert_counts = {}
for line in lines:
    parts = line.split()
    if len(parts) >= 4:
        level = parts[3]
        alert_counts[level] = alert_counts.get(level, 0) + 1

print("\n=== 告警级别统计 ===")
for level in ["CRITICAL", "HIGH", "MEDIUM", "LOW"]:
    count = alert_counts.get(level, 0)
    if count > 0:
        print(f"  {level:10s}: {count}次")
