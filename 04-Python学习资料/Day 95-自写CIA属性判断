# 需求：判断安全措施对应CIA哪个属性（机密/完整/可用）
measures = [
    "使用加密算法传输数据",      # 机密性
    "计算文件哈希校验完整性",    # 完整性
    "双机热备保证服务不中断",    # 可用性
    "定期备份防止数据丢失",      # 可用性
]

# 🔴 第一步：写步骤（中文，不写代码）
#   1. 遍历 measures，对每条措施
#   2. 判断关键词："加密"→机密性；"哈希"/"校验"→完整性；"备份"/"热备"/"不中断"→可用性
#   3. 打印 f"{措施} → {属性}"
#   写完步骤 → 对照模式卡"模式5 判断包含"翻译

# ✏️ 第二步：写代码

# 预期输出：
# 使用加密算法传输数据 → 机密性
# 计算文件哈希校验完整性 → 完整性
# 双机热备保证服务不中断 → 可用性
# 定期备份防止数据丢失 → 可用性

measures = [
    "使用加密算法传输数据",
    "计算文件哈希校验完整性",
    "双机热备保证服务不中断",
    "定期备份防止数据丢失",
]
for line in measures:
    if "加密" in line:
        attr = "机密性"
    elif "哈希" in line or "校验" in line:
        attr = "完整性"
    elif "备份" in line or "热备" in line or "不中断" in line:
        attr = "可用性"
    else:
        attr = "未知"
    print(f"{line} → {attr}")
