    ("登录失败锁定次数", "3", "5"),
    ("空闲锁屏时间(min)", "10", "5"),
]

def check_baseline(configs):
    # 🔴 第一步：写步骤（中文，不写代码）
    #   1. 遍历 configs 每一项 (名称, 实际值, 期望值)
    #   2. 实际值 == 期望值 → 合规；否则 → 不合规
    #   3. 打印 "名称: 合规/不合规 (实际=xx)"
    #   写完步骤 → 对照模式卡"模式6 遍历+条件" 翻译


configs = [
    ("SSH禁止root登录", "yes", "no"),
    ("密码最小长度(位)", "8", "12"),
    ("登录失败锁定次数", "3", "5"),
    ("空闲锁屏时间(min)", "10", "5"),
]

def check_baseline(configs):                     # 定义基线核查函数，入参configs：基线检查项列表
    for name, actual, expect in configs:         # 遍历列表，元组解包；name=检查项名称，actual=系统实际配置值，expect=基线期望值
        if actual == expect:                     # 判断：实际配置是否等于基线标准期望值
            status = "合规"                      # 相等：配置合规
        else:
            status = "不合规"                    # 不相等：配置不符合基线要求
        print(f"{name}: {status} (实际={actual})")# 格式化输出检查结果

check_baseline(configs)                          # 调用基线核查函数，执行全部检查
