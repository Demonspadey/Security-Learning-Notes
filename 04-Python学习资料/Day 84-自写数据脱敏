def mask_phone(phone):                                    # 手机号脱敏函数，传入手机号字符串
    return phone[:3] + "****" + phone[-4:]                # 截取前3位 + 4个星号 + 截取末尾4位，返回脱敏结果

def mask_idcard(idcard):                                  # 身份证脱敏函数，传入身份证字符串
    return idcard[:6] + "********" + idcard[-4:]          # 截取前6位 + 8个星号 + 截取末尾4位，返回脱敏结果

if __name__ == "__main__":                                # 程序入口，直接运行本脚本会执行下面代码
    phones=["13932301234", "15812345678", "13500001111"] # 定义手机号测试数据列表
    print("手机号脱敏")                                    # 打印标题
    for p in phones:                                      # 循环遍历列表中每一个手机号
        print(f" {p} → {mask_phone(p)}")                   # 打印原号码和脱敏后的号码

    ids=["510722199001011234", "110101198505054321"]      # 定义身份证测试数据列表
    print("身份证脱敏")                                    # 打印标题
    for d in ids:                                          # 循环遍历列表中每一个身份证
        print(f" {d} → {mask_idcard(d)}")                  # 打印原身份证和脱敏后的身份证
