import socket                     # 导入socket网络编程库，用于TCP端口探测
ips = ["192.168.11.100", "192.168.11.101", "192.168.11.102"]  # 需要扫描的IP资产列表
ports = [22, 80, 443]            # 需要探测的端口列表：ssh、http、https

def check_port(ip, port):         # 定义端口检测函数；参数ip：目标IP，port：目标端口
    s = socket.socket()           # 创建TCP套接字对象（注意必须带括号()）
    s.settimeout(2)               # 设置连接超时2秒，避免脚本长时间卡死等待
    res = s.connect_ex((ip, port))# connect_ex尝试TCP连接；返回0=端口开放，非0=关闭；不会抛出异常
    s.close()                     # 关闭socket，释放系统资源
    return res == 0               # 返回布尔值：True端口开放，False端口关闭

for ip in ips:                    # 【外层循环】逐个取出每一个IP地址
    for port in ports:            # 【内层嵌套循环】对当前IP，遍历全部待检测端口
        if check_port(ip, port):  # 调用函数探测端口状态
            print(f"{ip}:{port} 开放")   # 条件成立打印端口开放
        else:
            print(f"{ip}:{port} 关闭")   # 条件不成立打印端口关闭
