  预期输出：
    alice → file1:rw file2:r
    bob → file1:r


matrix = {
    "alice": {"file1": "rw", "file2": "r"},
    "bob":   {"file1": "r"},
}
def to_capability_table(matrix):
    """矩阵 → 能力表（以主体为中心）"""
    cap = {}
    for subject, objs in matrix.items():
        items = []
        for obj, perm in objs.items():
            items.append(f"{obj}:{perm}")
        cap[subject] = " ".join(items)
    return cap
for s, perms in to_capability_table(matrix).items():
    print(s, "→", perms)
