━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  题干：SM3密码杂凑算法的消息分组长度为（ ）比特
  你选：B（128）→ 正确：C（512）

  选项分析：
  A. 64 → ❌ 不是SM3的分组长度
  B. 128 → ❌ 你选的。128是SM4的分组长度！
  C. 512 → ✅ SM3消息分组长度512比特（Merkle-Damgård结构）⭐
  D. 1024 → ❌ 不是（1024是SHA-512的分组长度）

  知识点扩展：
  · SM3：分组512比特，输出256比特杂凑值
  · SM4：分组128比特；MD5/SHA-1分组也是512；SHA-512分组1024
  · 易混表：SM3=512/256 | SM4=128 | SM2=椭圆曲线非对称

