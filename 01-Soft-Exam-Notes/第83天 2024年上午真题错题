━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  题干：以下属于自主访问控制模型的是（ ）
  你选：B（BN模型）→ 正确：A（HRU模型）

  选项分析：
  A. HRU模型 → ✅ Harrison-Ruzzo-Ullman模型，经典的自主访问控制模型 ⭐
  B. BN模型 → ❌ （可能混淆了BLP或Biba，BN不是标准DAC术语）
  C. BLP模型 → ❌ 强制访问控制模型（保密性）
  D. 基于角色的访问控制模型 → ❌ RBAC，独立于DAC/MAC的分类

  自主vs强制：
  · 自主(DAC)：用户自行决定权限（HRU、ACL）
  · 强制(MAC)：系统强制策略（BLP、Biba）


