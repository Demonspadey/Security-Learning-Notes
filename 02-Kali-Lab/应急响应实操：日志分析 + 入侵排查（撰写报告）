Step 1.2 Kali 模拟暴力破解
──────────────────────────────────────────────────────────────────────────────
【Kali 上执行】
  # 用 hydra 模拟暴力破解
  sudo apt install hydra -y 2>/dev/null
  sudo apt install sshpass -y

  # 随机生成10个错误密码尝试（制造失败登录记录#这里命令是搜索的）
  for i in $(seq 1 10); do
      sshpass -p "wrongpass$i" ssh -o StrictHostKeyChecking=no \
          root@<UBUNTU_IP> 2>/dev/null
  done

  # 然后做一次成功登录（留下成功记录）
  ssh <Ubuntu用户名>@<UBUNTU_IP>
  # 输入密码登录，然后 exit 退出

  #这里因为ubuntu版本原因lastb这些被遗弃了就用w, gerp代替了lastb和who的操作步骤
  last可以查看到kali机成功登录的信息
  
  # 先清屏，看最新的认证日志
  sudo tail -30 /var/log/auth.log
  看到了kali机暴力破解的时间,ip地址，端口号，包括尝试登录用户名

  # 统计所有失败登录的IP
  sudo grep "Failed password" /var/log/auth.log | awk '{print $11}' | sort | uniq -c | sort -nr
  这里$11是端口号，然后$9是IP统计，然后又使用正则统计，正则可以不关心字段位置
  sudo grep "Failed password" /var/log/auth.log | grep -oP '\d+\.\d+\.\d+\.\d+' | sort | uniq -c | sort -nr
  
  # 统计所有成功登录的IP
  sudo grep "Accepted" /var/log/auth.log | awk '{print $9}' | sort | uniq -c | sort -nr

