访问控制核心实操——配权限 

Step 1.1 创建实验环境
──────────────────────────────────────────────────────────────────────────────

【Ubuntu 上操作】

  # 创建实验目录（放 /tmp 下，其他用户才能访问）
  # 不能放 ~/ 下！家目录权限是 700，其他用户进不来
  mkdir -p /tmp/access_control_test && cd /tmp/access_control_test

  # 创建测试文件
  echo "机密数据: 密码是 admin123" > secret.txt
  echo "公开数据: 欢迎访问" > public.txt
  echo "脚本文件" > script.sh

  # 创建测试用户（需要 sudo）
  sudo useradd -m testuser_alice   # 创建用户 alice
  sudo useradd -m testuser_bob     # 创建用户 bob

  # 设置密码（简单密码方便测试）
  echo "testuser_alice:qqwweerr11" | sudo chpasswd
  echo "testuser_bob:qqwweerr22" | sudo chpasswd

 Step 1.2 chmod 实操——改变文件权限
──────────────────────────────────────────────────────────────────────────────
  # 查看当前权限
  ls -l secret.txt
  # 输出: -rw-rw-r--  1 demon demon  ... secret.txt
  #       ↑文件类型     ↑所有者  ↑组
  #       rw-  rw-  r--
  #      所有者 组  其他人

  # secret.txt 只让所有者能读写（其他人什么都不能）
  chmod 600 secret.txt
  ls -l secret.txt
  # 变成: -rw-------  （只有所有者可读写）

  # public.txt 所有人都能读
  chmod 644 public.txt
  ls -l public.txt
  # 变成: -rw-r--r--  （所有者读写，其他人只读）

  # script.sh 加上可执行权限
  chmod +x script.sh
  ls -l script.sh
  # 变成: -rwxr-xr-x  （所有者读写执行，其他人读执行）

  # 测试权限效果: 切换成 alice 用户，看看能不能读 secret.txt
  su - testuser_alice
  cat /tmp/access_control_test/secret.txt
  # 报错 Permission denied！
  # 因为 secret.txt 是 600，只有所有者能读
  cat /tmp/access_control_test/public.txt
  # 能读，因为 public.txt 是 644，其他人有读权限
  exit  # 回到你自己的用户

Step 1.3 chown 实操——改变文件所有者
──────────────────────────────────────────────────────────────────────────────
  # 把 secret.txt 的所有者改成 testuser_alice
  sudo chown testuser_alice:testuser_alice secret.txt
  ls -l secret.txt
  # 所有者变成 testuser_alice 的了

  # 把 public.txt 的组改成 testuser_bob
  sudo chown :testuser_bob public.txt
  ls -l public.txt
  # 所有者的组变成 testuser_bob

  # 递归修改目录下所有文件的所有者（-R）
  sudo chown -R testuser_bob:testuser_bob /tmp/access_control_test/
  ls -la
  # 所有文件都变成 testuser_bob 的了

   （：前面是所有者，：后面是组）
  · chown user:group file = 同时改所有者和组
  · chown :group file = 只改组（不改变所有者）
  · chown -R = 递归修改（目录下所有文件都改）

Step 1.4 setfacl 实操——精细权限控制（比 chmod 更强大）
──────────────────────────────────────────────────────────────────────────────
  cd /tmp/access_control_test
  echo "ACL测试文件: 需要精细控制权限" > acl_test.txt

  # 查看当前 ACL
  getfacl acl_test.txt
  #   输出：
  #   # file: acl_test.txt
  #   # owner: demon
  #   # group: demon
  #   user::rw-      ← 所有者权限
  #   group::r--     ← 组权限
  #   other::r--     ← 其他人权限

  # 给 testuser_alice 单独设置读写权限（其他人仍然是 r--）
  setfacl -m u:testuser_alice:rw acl_test.txt

  # 再查看 ACL
  getfacl acl_test.txt
  # 多了一行：
  #   user:testuser_alice:rw-  ← alice 单独有读写权限！

  # 给 testuser_bob 设置无任何权限
  setfacl -m u:testuser_bob:--- acl_test.txt

  getfacl acl_test.txt
  # 又多了一行：
  #   user:testuser_bob:---   ← bob 被单独禁止了

  # 测试 ACL 效果
  # 切换到 alice
  su - testuser_alice
  cat /tmp/access_control_test/acl_test.txt
  # alice 能读（因为 setfacl 给了 rw）
  echo "alice 写入测试" >> /tmp/access_control_test/acl_test.txt
  # alice 也能写
  exit

  # 切换到 bob
  su - testuser_bob
  cat /tmp/access_control_test/acl_test.txt
  # bob 被拒！因为 setfacl 设置了 ---
  exit

  # 删除 ACL 条目
  setfacl -x u:testuser_alice acl_test.txt
  getfacl acl_test.txt
  # alice 的条目被删除了

Step 1.5 清理实验环境
──────────────────────────────────────────────────────────────────────────────
  # 删除测试用户（实验结束，清理干净）
  sudo userdel -r testuser_alice      
  #这里在删除的时候提醒用户正在进程中，然后ps -u testuser_alice查看到进程之后 可以kill掉进程，主要还是忘记cd ..进入上级目录的原因
  
  sudo userdel -r testuser_bob
  # 删除测试目录
  rm -rf /tmp/access_control_test
